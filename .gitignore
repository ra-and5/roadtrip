# esto se clona al servidor con cada `git pull`, así que lo que no haga falta
# allí no entra: la cuota del plan gratuito son 512 MB y el virtualenv ya se
# come ~100.
.agents/
agent/
.claude/
skills-lock.json
portfolio-staging/
