# Copia este archivo a .env y rellena los valores.
# Genera SECRET_KEY y APP_PASSWORD_HASH con:  python tools/hash_password.py
# NUNCA subas .env a git (ya está en .gitignore).

# =============================================================
# Obligatorias: sin ellas la app no arranca
# =============================================================
SECRET_KEY=
APP_PASSWORD_HASH=

# La cookie de sesión solo viaja por HTTPS. Déjalo VACÍO (= activado) siempre
# en el servidor: es la cookie que da acceso a toda la app.
# Ponlo a 0 únicamente para probar por http desde otro dispositivo de tu red
# local. En localhost no hace falta tocarlo: el navegador trata localhost como
# contexto seguro.
SESSION_COOKIE_SECURE=

# =============================================================
# Ingesta de telemetría del iPhone (Fase 2d)
# =============================================================
# HASH del token con el que el atajo del iPhone se autentica. Se genera con:
#
#     python tools/token_ingesta.py
#
# Ese comando imprime DOS cosas y van a sitios distintos:
#   - INGEST_TOKEN_HASH  -> aquí, en el .env.
#   - "Bearer <token>"   -> dentro del atajo del iPhone. Aquí NO.
#
# El token en claro no se guarda en el servidor: si lo pierdes, se genera otro
# y se actualizan las dos puntas.
#
# ⚠️ ESTE TOKEN NO PUEDE SER LA CONTRASEÑA DE LA APP, ni su hash. Son dos
#    secretos distintos a propósito: este vive EN CLARO dentro del iPhone, así
#    que si pierdes el móvil tienes que rotar este y solo este. Reutilizar la
#    contraseña convertiría un móvil perdido en un acceso completo a la web.
#    No lo generes a mano: 32 bytes al azar no se le ocurren a nadie.
#
# Si se deja vacío, el endpoint /api/telemetria responde 401 a todo. Es
# intencionado: sin configurar significa cerrado, nunca abierto.
INGEST_TOKEN_HASH=

# Máximo de muestras por envío. Con ventana solapada de 6 h llegan ~6; 500 deja
# margen para recuperar un día entero de fallos.
INGEST_MAX_SAMPLES=500

# Techo del cuerpo de cualquier petición, en bytes. Lo aplica Flask ANTES de
# parsear el JSON, que es donde se gasta la CPU (y en PythonAnywhere gratuito
# la CPU es cuota diaria). Por defecto 131072 (128 KiB).
MAX_CONTENT_LENGTH=

# =============================================================
# Proveedor de LLM
# =============================================================
# Qué proveedor usa la app: anthropic | gemini | kimi | ollama
#   anthropic -> Claude. Requiere saldo en la cuenta.
#   gemini    -> Google AI Studio. Capa gratuita, SIN tarjeta.
#   kimi      -> Moonshot AI. Sin capa gratuita: se activa recargando 1 $.
#   ollama    -> modelo local. Estructura preparada, aún sin implementar.
# Cambiar esta línea es lo único que hace falta para cambiar de modelo.
LLM_PROVIDER=gemini

# --- Gemini (Google AI Studio) -------------------------------
# Cómo sacar la key:
#   1. aistudio.google.com  ->  inicia sesión con tu cuenta de Google
#   2. Botón "Get API key" (arriba a la izquierda)
#   3. "Create API key"  ->  elige o crea un proyecto de Google Cloud
#   4. Copia la clave. No pide tarjeta.
#      (El prefijo varía: "AIza...", "AQ...." Ambos son válidos.)
GEMINI_API_KEY=
# OJO: la lista que devuelve la API NO es la lista de modelos que puedes usar.
# Comprobado: gemini-2.5-flash aparece listado y responde 404 ("no longer
# available to new users"), y los "pro" devuelven 429 por cuota agotada.
# Averigua cuáles funcionan CON TU KEY:  python tools/listar_modelos.py
# Se fija un modelo concreto y no un alias ("gemini-flash-latest") porque al
# afinar un prompt necesitas reproducibilidad.
GEMINI_MODEL=gemini-3.6-flash

# --- Kimi (Moonshot AI) --------------------------------------
# No hay capa gratuita. La key se saca en platform.kimi.ai > Console >
# API Keys, y no funciona hasta que recargas el mínimo (1 $). Al llegar a 5 $
# acumulados te abonan un vale de 5 $.
KIMI_API_KEY=
# Cuánto cuesta cada recomendación (contexto ~2.500 tokens dentro):
#   kimi-k3         3,00 $/M dentro, 15,00 $/M fuera  -> ~0,03 $  (~30 con 1 $)
#   kimi-k2.6       0,95 $/M dentro,  4,00 $/M fuera  -> ~0,006 $ (~160 con 1 $)
#   kimi-k2.7-code  0,95 $/M dentro,  4,00 $/M fuera  -> ~0,006 $ (~160 con 1 $)
# Por defecto kimi-k3: es el único modelo NO especializado en código cuya
# documentación garantiza salida estructurada estable, y nuestro esquema tiene
# un array de objetos anidados con enums. De kimi-k2.6 avisan de que "se
# comporta de forma inestable con esquemas complejos" (puede devolver el JSON
# envuelto en markdown o colarse campos fuera del esquema).
# Si 30 recomendaciones se te quedan cortas, kimi-k2.6 sale 5 veces más barato
# a cambio de ese riesgo. Pruébalo con: python tools/diagnostico.py
KIMI_MODEL=kimi-k3
# Cuánto razona kimi-k3: low | high | max
# OJO: NO son los mismos valores que ANTHROPIC_EFFORT (que además acepta
# medium y xhigh). Un valor inválido da un error que nombra la variable.
# Solo aplica a kimi-k3; los demás modelos usan otro mando.
KIMI_REASONING_EFFORT=low
# Cámbialo solo si usas el endpoint de China (https://api.moonshot.cn/v1).
KIMI_BASE_URL=https://api.moonshot.ai/v1

# --- Anthropic (Claude) --------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Cuánto razona el modelo: low | medium | high | xhigh | max
# Mando de latencia contra calidad. Empieza en low y sube si las
# recomendaciones te saben a poco.
ANTHROPIC_EFFORT=low

# =============================================================
# Depuración
# =============================================================
# Muestra en la INTERFAZ el mensaje de error crudo del proveedor.
# Útil mientras afinas el prompt; déjalo desactivado en producción.
# El detalle completo va siempre al log y a tools/diagnostico.py.
# La API key NUNCA aparece en un error, con esto activado o no.
SHOW_AI_ERROR_DETAIL=

# =============================================================
# APIs sin key
# =============================================================
# Obligatorio por la política de uso de Nominatim: identifícate con un
# contacto real, o pueden bloquear la IP del servidor.
NOMINATIM_USER_AGENT=roadtrip-companion/0.1 (tu-nombre; tu@email.com)
HTTP_TIMEOUT=10

# Dónde viven la base de datos y las fotos. Por defecto ./data
# En PythonAnywhere puede interesarte una ruta absoluta.
DATA_DIR=
